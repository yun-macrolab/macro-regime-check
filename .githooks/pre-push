#!/bin/sh
# push 전에 공개 전 검사 — CI의 같은 검사는 push가 이미 공개된 뒤에 돈다.
# 켜기: git config core.hooksPath .githooks   (저장소마다 한 번, 로컬 설정)
cd "$(git rev-parse --show-toplevel)" || exit 1
python scripts/check_blind.py || { echo "push 중단: 공개 전 검사를 통과하지 못했다" >&2; exit 1; }
# 화면 폴더 검사 — 같은 출처에 놓이는 파일의 낱말 · 확장자(node · 네트워크 불필요)
python scripts/test_site_origin.py || { echo "push 중단: 화면 폴더 검사를 통과하지 못했다" >&2; exit 1; }
