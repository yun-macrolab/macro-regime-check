ttps://mods.go.kr/index.es?sid=a1"},{"term":"반도체","text":"메모리(D램·낸드)·HBM·파운드리 등 반도체 산업의 글","url":null},{"term":"미 국채 입찰","text":"미 재무부의 국채 경쟁입찰. 응찰률과 낙찰금리로 수요를 본다","url":"https://www.treasurydirect.gov/auctions/upcoming/"},{"term":"미 국채 발행계획","text":"미 재무부의 분기 리펀딩 발표. 만기별 발행 규모를 밝힌다","url":"https://home.treasury.gov/policy-issues/financing-the-government/quarterly-refunding"},{"term":"국채 입찰","text":"나라를 밝히지 않은 국채 입찰 글. 응찰률은 발행액에 견준 응찰액의 비율","url":null},{"term":"기간 프리미엄","text":"장기채를 들고 가는 대가로 요구하는 추가 보상. 모형 추정값이다","url":"https://www.newyorkfed.org/research/data_indicators/term-premia-tabs"},{"term":"미 재정","text":"미국 연방 재정. 적자·부채 한도·예산 처리 일정을 본다","url":"https://fiscaldata.treasury.gov/americas-finance-guide/national-deficit/"},{"term":"단기자금","text":"초단기 달러 자금 시장. 역레포 잔고·지급준비금·SOFR를 본다","url":"https://www.newyorkfed.org/markets/reference-rates/sofr"},{"term":"국고채 발행계획","text":"재정경제부가 매달 말 내는 다음 달 국고채 발행 물량과 일정","url":"https://ktb.mofe.go.kr/mnbyIsuCldr.do"},{"term":"국내 크레딧","text":"국내 회사채·여전채 등 신용 채권 시장","url":null},{"term":"국고채 커브","text":"국고채 만기별 금리 차. 3년과 10년 금리의 차이를 주로 본다","url":null},{"term":"미 국채 커브","text":"미 국채 만기별 금리 차. 2년과 10년 금리의 차이를 주로 본다","url":"https://fred.stlouisfed.org/series/T10Y2Y"},{"term":"커브","text":"수익률곡선. 장단기 금리 차가 벌어지면 스팁, 좁혀지면 플랫","url":null},{"term":"미 국채 금리","text":"미 국채 수익률. 재무부가 매일 만기별 금리를 고시한다","url":"https://home.treasury.gov/policy-issues/financing-the-government/interest-rate-statistics"},{"term":"초장기","text":"만기 20년 이상인 국채. 한국은 20년·30년·50년물 국고채가 있다","url":null},{"term":"국가 신용등급","text":"신용평가사가 매기는 나라의 신용등급과 등급 전망","url":null},{"term":"지정학","text":"전쟁·분쟁·봉쇄처럼 나라 사이의 정치·군사적 긴장","url":null},{"term":"미 증시","text":"나스닥·S&P 500·다우 등 미국 주가지수","url":null},{"term":"통화정책","text":"중앙은행이 금리와 시중의 돈의 양을 조절하는 정책","url":null},{"term":"주요국 중앙은행","text":"호주·캐나다·스위스·뉴질랜드 등의 중앙은행","url":null},{"term":"근원물가","text":"식품과 에너지를 뺀 물가. 흐름의 바탕을 보려고 쓴다","url":null},{"term":"물가연동채","text":"원금이 소비자물가에 따라 조정되는 국채. 미국은 TIPS","url":null},{"term":"장기금리","text":"만기가 긴 채권의 금리. 보통 10년 이상 국채 금리를 가리킨다","url":null}]}