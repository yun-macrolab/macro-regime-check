gloss":[{"term":"FOMC","text":"연준의 금리 결정 회의. 한 해 8번 열리고 결정문과 의장 회견이 나온다","url":"https://fred.stlouisfed.org/series/DFEDTARU"},{"term":"연준 발언","text":"연준 의장·이사·지역 연은 총재의 공개 발언. 회의 전 묵언 기간에는 삼간다","url":null},{"term":"연준 의장 인선","text":"연준 의장은 대통령이 지명하고 상원이 인준한다. 임기는 4년","url":null},{"term":"ECB","text":"유럽중앙은행. 유로존의 통화정책을 정한다","url":null},{"term":"BOJ","text":"일본은행. 일본의 통화정책을 정한다","url":"https://www.boj.or.jp/en/mopo/mpmsche_minu/index.htm"},{"term":"BOE","text":"영란은행. 영국의 통화정책을 정한다","url":null},{"term":"정책 기대","text":"시장 금리에 반영된 기준금리 인상·인하 기대","url":null},{"term":"연준","text":"미국의 중앙은행 제도인 연방준비제도(Fed)를 줄여 부르는 말","url":null},{"term":"미 CPI","text":"미국 소비자물가지수. 노동통계국(BLS)이 매달 내는 대표 물가 지표","url":"https://fred.stlouisfed.org/series/CPIAUCSL"},{"term":"미 고용","text":"미국 고용보고서. 비농업 취업자 수·실업률·임금이 매달 함께 나온다","url":"https://fred.stlouisfed.org/series/PAYEMS"},{"term":"미 PPI","text":"미국 생산자물가지수. 기업이 받는 값의 변화를 본다","url":"https://fred.stlouisfed.org/series/PPIFIS"},{"term":"미 GDP","text":"미국 국내총생산. 경제분석국(BEA)이 분기마다 내고 뒤에 수정한다","url":"https://www.bea.gov/data/gdp/gross-domestic-product"},{"term":"미 실업수당","text":"미국 신규 실업수당 청구 건수. 노동부가 매주 목요일에 낸다","url":"https://fred.stlouisfed.org/series/ICSA"},{"term":"ADP","text":"급여 처리 회사 ADP가 내는 미국 민간 고용 집계","url":null},{"term":"미 임금","text":"미국 시간당 평균임금과 고용비용지수(ECI). 임금발 물가 압력을 본다","url":"https://fred.stlouisfed.org/series/ECIALLCIV"},{"term":"미 소비심리","text":"미시간대 소비자심리지수와 컨퍼런스보드 소비자신뢰지수","url":"https://fred.stlouisfed.org/series/UMCSENT"},{"term":"기대인플레","text":"앞으로의 물가 상승률 기대. 설문이나 BEI(일반 국채와 물가연동채의 금리 차)로 잰다","url":"https://fred.stlouisfed.org/series/T10YIE"},{"term":"유가","text":"국제 원유 가격. WTI와 브렌트가 기준 유종이다","url":"https://www.eia.gov/dnav/pet/pet_pri_spt_s1_d.htm"},{"term":"설비투자 금액","text":"기업이 밝힌 설비투자(capex) 금액","url":null},{"term":"빅테크 실적","text":"대형 기술 기업의 분기 실적과 가이던스","url":null},{"term":"AI Capex","text":"기업의 설비투자(capex). AI·데이터센터 투자 글을 주로 센다","url":null},{"term":"데이터센터","text":"서버를 대량으로 모아 둔 시설. 초대형 운영사를 하이퍼스케일러라 부른다","url":null},{"term":"AI","text":"인공지능. GPU·LLM 같은 관련 낱말도 이 낱말로 센다","url":null},{"term":"인플레","text":"인플레이션. 물가가 전반적으로 오르는 일. 디스인플레이션은 오름세가 느려지는 것","url":null},{"term":"원자재","text":"천연가스·구리처럼 산업의 원료가 되는 상품. 에너지 가격 글도 이 낱말로 센다","url":null},{"term":"한국 GDP","text":"한국 실질 국내총생산. 한국은행이 분기마다 속보치·잠정치를 낸다","url":"https://ecos.bok.or.kr/"},{"term":"한국 수출","text":"한국 수출입 통계. 관세청이 열흘 단위 잠정치와 월간 실적을 낸다","url":"https://tradedata.go.kr/cts/index.do"},{"term":"반도체","text":"메모리(D램·낸드)·HBM·파운드리 등 반도체 산업의 글","url":null},{"term":"국채 입찰","text":"나라를 밝히지 않은 국채 입찰 글. 응찰률은 발행액에 견준 응찰액의 비율","url":null},{"term":"미 재정","text":"미국 연방 재정. 적자·부채 한도·예산 처리 일정을 본다","url":"https://fiscaldata.treasury.gov/americas-finance-guide/national-deficit/"},{"term":"국고채 입찰","text":"국고채 경쟁입찰. 국고채전문딜러(PD)가 응찰한다","url":"https://ktb.mofe.go.kr/isuNdReprchsPblanc.do"},{"term":"국고채 커브","text":"국고채 만기별 금리 차. 3년과 10년 금리의 차이를 주로 본다","url":null},{"term":"국고채 금리","text":"한국 정부가 발행하는 국채(국고채)의 만기별 금리. 3년·10년물을 주로 본다","url":null},{"term":"미 국채 금리","text":"미 국채 수익률. 재무부가 매일 만기별 금리를 고시한다","url":"https://home.treasury.gov/policy-issues/financing-the-government/interest-rate-statistics"},{"term":"지정학","text":"전쟁·분쟁·봉쇄처럼 나라 사이의 정치·군사적 긴장","url":null},{"term":"미 증시","text":"나스닥·S&P 500·다우 등 미국 주가지수","url":null},{"term":"국내 증시","text":"코스피·코스닥 등 한국 주가지수","url":null},{"term":"근원물가","text":"식품과 에너지를 뺀 물가. 흐름의 바탕을 보려고 쓴다","url":null},{"term":"노동시장","text":"일자리와 임금이 정해지는 시장. 고용·실업·임금 지표로 본다","url":null},{"term":"미 생산성","text":"미국 비농업 부문의 시간당 산출과 단위노동비용","url":"https://fred.stlouisfed.org/series/OPHNFB"},{"term":"헤지펀드","text":"여러 전략을 쓰는 사모 펀드. 국채 현물·선물 차익 거래 글에 자주 나온다","url":null},{"term":"공매도","text":"주식을 빌려서 판 뒤 나중에 사서 갚는 거래","url":null}]}