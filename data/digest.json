:null},{"term":"기대인플레","text":"앞으로의 물가 상승률 기대. 설문이나 BEI(일반 국채와 물가연동채의 금리 차)로 잰다","url":"https://fred.stlouisfed.org/series/T10YIE"},{"term":"유가","text":"국제 원유 가격. WTI와 브렌트가 기준 유종이다","url":"https://www.eia.gov/dnav/pet/pet_pri_spt_s1_d.htm"},{"term":"AI 회사채 발행","text":"AI·데이터센터 투자를 위한 회사채·사모대출 조달","url":null},{"term":"빅테크 실적","text":"대형 기술 기업의 분기 실적과 가이던스","url":null},{"term":"AI Capex","text":"기업의 설비투자(capex). AI·데이터센터 투자 글을 주로 센다","url":null},{"term":"데이터센터","text":"서버를 대량으로 모아 둔 시설. 초대형 운영사를 하이퍼스케일러라 부른다","url":null},{"term":"AI","text":"인공지능. GPU·LLM 같은 관련 낱말도 이 낱말로 센다","url":null},{"term":"원자재","text":"천연가스·구리처럼 산업의 원료가 되는 상품. 에너지 가격 글도 이 낱말로 센다","url":null},{"term":"한국 수출","text":"한국 수출입 통계. 관세청이 열흘 단위 잠정치와 월간 실적을 낸다","url":"https://tradedata.go.kr/cts/index.do"},{"term":"반도체","text":"메모리(D램·낸드)·HBM·파운드리 등 반도체 산업의 글","url":null},{"term":"기간 프리미엄","text":"장기채를 들고 가는 대가로 요구하는 추가 보상. 모형 추정값이다","url":"https://www.newyorkfed.org/research/data_indicators/term-premia-tabs"},{"term":"미 재정","text":"미국 연방 재정. 적자·부채 한도·예산 처리 일정을 본다","url":"https://fiscaldata.treasury.gov/americas-finance-guide/national-deficit/"},{"term":"국고채 입찰","text":"국고채 경쟁입찰. 국고채전문딜러(PD)가 응찰한다","url":"https://ktb.mofe.go.kr/isuNdReprchsPblanc.do"},{"term":"외국인 국채선물","text":"외국인의 3년·10년 국채선물 순매수·순매도 계약 수","url":null},{"term":"WGBI","text":"FTSE 러셀의 세계국채지수. 편입된 국채는 지수를 따르는 자금의 매수 대상이 된다","url":null},{"term":"국내 크레딧","text":"국내 회사채·여전채 등 신용 채권 시장","url":null},{"term":"국내 단기자금","text":"CD·CP·콜·RP 등 국내 단기 금리와 자금 사정","url":null},{"term":"국고채 커브","text":"국고채 만기별 금리 차. 3년과 10년 금리의 차이를 주로 본다","url":null},{"term":"미 국채 커브","text":"미 국채 만기별 금리 차. 2년과 10년 금리의 차이를 주로 본다","url":"https://fred.stlouisfed.org/series/T10Y2Y"},{"term":"커브","text":"수익률곡선. 장단기 금리 차가 벌어지면 스팁, 좁혀지면 플랫","url":null},{"term":"국고채 금리","text":"한국 정부가 발행하는 국채(국고채)의 만기별 금리. 3년·10년물을 주로 본다","url":null},{"term":"미 국채 금리","text":"미 국채 수익률. 재무부가 매일 만기별 금리를 고시한다","url":"https://home.treasury.gov/policy-issues/financing-the-government/interest-rate-statistics"},{"term":"기술적 수준","text":"이평선·지지선·저항선처럼 차트에서 읽는 값의 자리","url":null},{"term":"국가 신용등급","text":"신용평가사가 매기는 나라의 신용등급과 등급 전망","url":null},{"term":"관세","text":"수입품에 매기는 세금. 무역 협상 글도 이 낱말로 센다","url":null},{"term":"지정학","text":"전쟁·분쟁·봉쇄처럼 나라 사이의 정치·군사적 긴장","url":null},{"term":"미 증시","text":"나스닥·S&P 500·다우 등 미국 주가지수","url":null},{"term":"국내 증시","text":"코스피·코스닥 등 한국 주가지수","url":null},{"term":"통화정책","text":"중앙은행이 금리와 시중의 돈의 양을 조절하는 정책","url":null},{"term":"주요국 중앙은행","text":"호주·캐나다·스위스·뉴질랜드 등의 중앙은행","url":null},{"term":"금융여건","text":"금리·신용 스프레드·주가·환율을 묶어 본 자금 조달 환경","url":"https://www.chicagofed.org/research/data/nfci/current-data"},{"term":"장기금리","text":"만기가 긴 채권의 금리. 보통 10년 이상 국채 금리를 가리킨다","url":null}]}